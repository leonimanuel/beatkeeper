{
  "name": "beatkeeper",
  "version": "0.2.0",
  "description": "Resolve which unit of a scripted narration a TTS voice is speaking, from its word stream. Emits an index; renders nothing.",
  "license": "MIT",
  "author": "Leon Malisov",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./pipecat": {
      "types": "./dist/adapters/pipecat.d.ts",
      "import": "./dist/adapters/pipecat.js",
      "default": "./dist/adapters/pipecat.js"
    },
    "./livekit": {
      "types": "./dist/adapters/livekit.d.ts",
      "import": "./dist/adapters/livekit.js",
      "default": "./dist/adapters/livekit.js"
    },
    "./elevenlabs": {
      "types": "./dist/adapters/elevenlabs.d.ts",
      "import": "./dist/adapters/elevenlabs.js",
      "default": "./dist/adapters/elevenlabs.js"
    },
    "./ag-ui": {
      "types": "./dist/adapters/ag-ui.d.ts",
      "import": "./dist/adapters/ag-ui.js",
      "default": "./dist/adapters/ag-ui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "beat",
    "narration",
    "voice-agent",
    "tts",
    "alignment",
    "word-timestamps",
    "generative-ui",
    "pipecat",
    "livekit",
    "elevenlabs",
    "ag-ui"
  ]
}
